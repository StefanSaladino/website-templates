{
  "fulcrum-light": {
    "stage": ".stage",
    "canvas": "#lamp-canvas",
    "fallback": ".fallback",
    "initial": {
      "data-rendered-finish": "ochre",
      "data-rendered-brightness": "60"
    },
    "steps": [
      {
        "selector": "button[data-finish=chalk]",
        "action": "click",
        "state": {
          "data-rendered-finish": "chalk"
        }
      },
      {
        "selector": "#rotation",
        "action": "fill",
        "value": "80",
        "state": {
          "data-rendered-angle": "80"
        }
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "0",
        "state": {
          "data-rendered-brightness": "0"
        },
        "controlState": {
          "aria-valuetext": "Off"
        },
        "stableGeometry": true
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "100",
        "state": {
          "data-rendered-brightness": "100"
        },
        "controlState": {
          "aria-valuetext": "100 percent brightness"
        },
        "stableGeometry": true
      }
    ],
    "reset": {
      "selector": "#reset",
      "state": {
        "data-rendered-finish": "ochre",
        "data-rendered-brightness": "60",
        "data-rendered-angle": "-25"
      }
    },
    "fallbackDisabled": [
      "#rotation"
    ],
    "fallbackSteps": [
      {
        "selector": "button[data-finish=graphite]",
        "action": "click",
        "state": {
          "data-finish": "graphite"
        }
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "0",
        "state": {
          "data-brightness": "0"
        },
        "fixedSelectors": [
          ".fallback-base",
          ".fallback-post",
          ".fallback-shade",
          ".fallback-diffuser"
        ]
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "100",
        "state": {
          "data-brightness": "100"
        },
        "fixedSelectors": [
          ".fallback-base",
          ".fallback-post",
          ".fallback-shade",
          ".fallback-diffuser"
        ]
      }
    ],
    "requireFraming": true
  },
  "strata-architecture": {
    "stage": ".stage",
    "canvas": "#architecture",
    "fallback": ".fallback",
    "initial": {
      "data-rendered-view": "exterior",
      "data-rendered-light": "day"
    },
    "steps": [
      {
        "selector": "button[data-view=courtyard]",
        "action": "click",
        "state": {
          "data-rendered-view": "courtyard"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      },
      {
        "selector": "button[data-view=plan]",
        "action": "click",
        "state": {
          "data-rendered-view": "plan"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      },
      {
        "selector": "button[data-light=dusk]",
        "action": "click",
        "state": {
          "data-rendered-light": "dusk"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      },
      {
        "selector": "button[data-view=exterior]",
        "action": "click",
        "state": {
          "data-rendered-view": "exterior"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      }
    ],
    "reset": {
      "selector": "#reset",
      "state": {
        "data-rendered-view": "exterior",
        "data-rendered-light": "day"
      }
    },
    "fallbackSteps": [
      {
        "selector": "button[data-view=plan]",
        "action": "click",
        "state": {
          "data-view": "plan"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      },
      {
        "selector": "button[data-light=dusk]",
        "action": "click",
        "state": {
          "data-light": "dusk"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      },
      {
        "selector": "button[data-view=courtyard]",
        "action": "click",
        "state": {
          "data-view": "courtyard"
        }
      }
    ],
    "allowedImageIdentities": [
      "https://images.pexels.com/photos/34658645/pexels-photo-34658645.jpeg",
      "https://images.pexels.com/photos/31446187/pexels-photo-31446187.jpeg"
    ]
  },
  "abyss-ocean": {
    "stage": "#environment",
    "canvas": "#ocean-canvas",
    "fallback": ".fallback",
    "initial": {
      "data-rendered-zone": "surface",
      "data-rendered-depth": "0",
      "data-rendered-paused": "true"
    },
    "steps": [
      {
        "selector": "[data-jump=twilight]",
        "action": "click",
        "state": {
          "data-rendered-zone": "twilight"
        },
        "controlState": {
          "aria-current": "location"
        }
      },
      {
        "selector": "[data-jump=midnight]",
        "action": "click",
        "state": {
          "data-rendered-zone": "midnight"
        }
      },
      {
        "selector": "[data-jump=deep]",
        "action": "click",
        "state": {
          "data-rendered-zone": "deep"
        }
      },
      {
        "selector": "[data-jump=twilight]",
        "action": "click",
        "state": {
          "data-rendered-zone": "twilight"
        }
      }
    ],
    "reset": {
      "selector": "[data-jump=surface]",
      "state": {
        "data-rendered-zone": "surface",
        "data-rendered-depth": "0"
      }
    },
    "fallbackSteps": [
      {
        "selector": "[data-jump=midnight]",
        "action": "click",
        "state": {
          "data-zone": "midnight"
        }
      },
      {
        "selector": "[data-jump=surface]",
        "action": "click",
        "state": {
          "data-zone": "surface"
        }
      }
    ],
    "fallbackDisabled": [
      "#motion",
      "#quality"
    ],
    "fixedStage": true,
    "animatedChecks": true,
    "qualityToggle": "#quality"
  },
  "prism-optics": {
    "stage": "#environment",
    "canvas": "#lens",
    "fallback": ".fallback",
    "fixedStage": true,
    "initial": {
      "data-rendered-scene": "reveal",
      "data-rendered-finish": "graphite",
      "data-rendered-explode": "0.000"
    },
    "steps": [
      {
        "selector": "[data-jump=craft]",
        "action": "click",
        "state": {
          "data-rendered-scene": "craft"
        }
      },
      {
        "selector": "[data-jump=optics]",
        "action": "click",
        "state": {
          "data-rendered-scene": "optics",
          "data-rendered-explode": "1.000"
        }
      },
      {
        "selector": "[data-jump=inspect]",
        "action": "click",
        "state": {
          "data-rendered-scene": "inspect",
          "data-rendered-explode": "0.000"
        }
      },
      {
        "selector": "button[data-finish=silver]",
        "action": "click",
        "state": {
          "data-rendered-finish": "silver"
        },
        "controlState": {
          "aria-pressed": "true"
        }
      },
      {
        "selector": "#rotation",
        "action": "fill",
        "value": "85",
        "state": {
          "data-rendered-angle": "85"
        },
        "controlState": {
          "aria-valuetext": "85 degrees"
        }
      }
    ],
    "reset": {
      "selector": "#reset",
      "state": {
        "data-rendered-finish": "graphite",
        "data-rendered-angle": "0"
      }
    },
    "fallbackDisabled": [
      "#rotation"
    ],
    "fallbackSteps": [
      {
        "selector": "[data-jump=optics]",
        "action": "click",
        "state": {
          "data-scene": "optics"
        }
      },
      {
        "selector": "[data-jump=inspect]",
        "action": "click",
        "state": {
          "data-scene": "inspect"
        }
      },
      {
        "selector": "button[data-finish=bronze]",
        "action": "click",
        "state": {
          "data-finish": "bronze"
        }
      }
    ],
    "productTimeline": true
  },
  "event-horizon": {
    "stage": "#environment",
    "canvas": "#space-canvas",
    "fallback": ".fallback",
    "fixedStage": true,
    "initial": {
      "data-rendered-zone": "approach",
      "data-rendered-progress": "0.000",
      "data-rendered-paused": "true",
      "data-rendered-mass": "100"
    },
    "steps": [
      {
        "selector": "[data-jump=lensing]",
        "action": "click",
        "state": {
          "data-rendered-zone": "lensing"
        },
        "controlState": {
          "aria-current": "location"
        }
      },
      {
        "selector": "#gravity",
        "action": "fill",
        "value": "150",
        "state": {
          "data-rendered-mass": "150"
        }
      },
      {
        "selector": "[data-jump=accretion]",
        "action": "click",
        "state": {
          "data-rendered-zone": "accretion"
        }
      },
      {
        "selector": "[data-jump=horizon]",
        "action": "click",
        "state": {
          "data-rendered-zone": "horizon",
          "data-rendered-progress": "1.000"
        }
      },
      {
        "selector": "[data-jump=lensing]",
        "action": "click",
        "state": {
          "data-rendered-zone": "lensing"
        }
      }
    ],
    "reset": {
      "selector": "[data-jump=approach]",
      "state": {
        "data-rendered-zone": "approach",
        "data-rendered-progress": "0.000"
      }
    },
    "fallbackSteps": [
      {
        "selector": "[data-jump=horizon]",
        "action": "click",
        "state": {
          "data-zone": "horizon"
        }
      },
      {
        "selector": "[data-jump=approach]",
        "action": "click",
        "state": {
          "data-zone": "approach"
        }
      }
    ],
    "fallbackDisabled": [
      "#gravity",
      "#motion",
      "#quality"
    ],
    "qualityToggle": "#quality",
    "lensingTimeline": true
  },
  "shift-card": {
    "dedicated": true,
    "workflow": ".github/workflows/shift-recovery-live.yml",
    "scripts": [
      "test-shift-recovery-live.mjs",
      "test-shift-recovery-accessibility.mjs",
      "test-shift-recovery-projection.mjs",
      "test-shift-model.mjs",
      "test-shift-components.mjs"
    ],
    "reason": "Recovery suite verifies continuous bounded composition, actual mesh projection and rendering, accessibility, model study and both reusable component examples."
  },
  "selvedge-outerwear": {
    "dedicated": true,
    "workflow": ".github/workflows/selvedge-storyboard.yml",
    "scripts": [
      "test-selvedge-storyboard.mjs"
    ],
    "reason": "Specialist verifies real photographic crop, native wheel, reversible continuous motion, cadence, responsive recovery and native embedded palette."
  }
}
