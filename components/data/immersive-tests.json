{
  "fulcrum-light": {
    "stage": ".stage",
    "canvas": "#lamp-canvas",
    "fallback": ".fallback",
    "initial": {
      "data-rendered-finish": "ochre",
      "data-rendered-assembly": "0"
    },
    "steps": [
      {
        "selector": "button[data-finish=chalk]",
        "action": "click",
        "state": {
          "data-rendered-finish": "chalk"
        }
      },
      {
        "selector": "#rotation",
        "action": "fill",
        "value": "80",
        "state": {
          "data-rendered-angle": "80"
        }
      },
      {
        "selector": "#assembly",
        "action": "fill",
        "value": "50",
        "state": {
          "data-rendered-assembly": "50"
        },
        "controlState": {
          "aria-valuetext": "50 percent separated"
        },
        "stableBottomFraction": 0.34
      },
      {
        "selector": "#assembly",
        "action": "fill",
        "value": "100",
        "state": {
          "data-rendered-assembly": "100"
        },
        "controlState": {
          "aria-valuetext": "Fully separated"
        },
        "stableBottomFraction": 0.34
      }
    ],
    "reset": {
      "selector": "#reset",
      "state": {
        "data-rendered-finish": "ochre",
        "data-rendered-assembly": "0",
        "data-rendered-angle": "-25"
      }
    },
    "fallbackDisabled": [
      "#rotation"
    ],
    "fallbackSteps": [
      {
        "selector": "button[data-finish=graphite]",
        "action": "click",
        "state": {
          "data-finish": "graphite"
        }
      },
      {
        "selector": "#assembly",
        "action": "fill",
        "value": "100",
        "state": {
          "data-assembly": "100"
        },
        "fixedSelectors": [
          ".fallback-base",
          ".fallback-post"
        ]
      }
    ],
    "requireFraming": true
  }
}
