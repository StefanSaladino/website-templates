{
  "fulcrum-light": {
    "stage": ".stage",
    "canvas": "#lamp-canvas",
    "fallback": ".fallback",
    "initial": {
      "data-rendered-finish": "ochre",
      "data-rendered-brightness": "60"
    },
    "steps": [
      {
        "selector": "button[data-finish=chalk]",
        "action": "click",
        "state": {
          "data-rendered-finish": "chalk"
        }
      },
      {
        "selector": "#rotation",
        "action": "fill",
        "value": "80",
        "state": {
          "data-rendered-angle": "80"
        }
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "0",
        "state": {
          "data-rendered-brightness": "0"
        },
        "controlState": {
          "aria-valuetext": "Off"
        },
        "stableGeometry": true
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "100",
        "state": {
          "data-rendered-brightness": "100"
        },
        "controlState": {
          "aria-valuetext": "100 percent brightness"
        },
        "stableGeometry": true
      }
    ],
    "reset": {
      "selector": "#reset",
      "state": {
        "data-rendered-finish": "ochre",
        "data-rendered-brightness": "60",
        "data-rendered-angle": "-25"
      }
    },
    "fallbackDisabled": [
      "#rotation"
    ],
    "fallbackSteps": [
      {
        "selector": "button[data-finish=graphite]",
        "action": "click",
        "state": {
          "data-finish": "graphite"
        }
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "0",
        "state": {
          "data-brightness": "0"
        },
        "fixedSelectors": [
          ".fallback-base",
          ".fallback-post",
          ".fallback-shade",
          ".fallback-diffuser"
        ]
      },
      {
        "selector": "#brightness",
        "action": "fill",
        "value": "100",
        "state": {
          "data-brightness": "100"
        },
        "fixedSelectors": [
          ".fallback-base",
          ".fallback-post",
          ".fallback-shade",
          ".fallback-diffuser"
        ]
      }
    ],
    "requireFraming": true
  }
}
